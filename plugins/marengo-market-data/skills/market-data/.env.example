# API keys for scripts/chart.py. Copy this file to .env (which is gitignored)
# and fill in the values. Never commit real keys or paste them into chat.

# Alpha Vantage — equities, ETFs, crypto, FX, indicators, fundamentals.
# Same key as the connected MCP server; the script needs it directly for --source av-*.
ALPHAVANTAGE_API_KEY=

# Databento — CME futures & options on futures (Historical API key). Used for --source databento.
DATABENTO_API_KEY=
